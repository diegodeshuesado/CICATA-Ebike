# Plantilla de variables de entorno -- copia este archivo a ".env" y
# rellena los valores reales. ".env" NUNCA debe subirse a git (ver .gitignore
# y PLAN_MEJORAS.md, punto S3); este archivo de ejemplo sí se versiona
# porque no contiene ningún secreto real.

INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=coloca_aqui_tu_token_de_influxdb
INFLUXDB_ORG=IPN CICATA QRO
INFLUXDB_BUCKET=scada_lev

# Opcional (S5): orígenes permitidos por CORS para el backend Express,
# separados por comas. Si no se define, usa por defecto
# "http://localhost:3000,http://127.0.0.1:3000" (el frontend Vite local).
# Solo hace falta tocar esto si necesitas llamar a la API (puerto 3001)
# directo desde el navegador con un origen distinto al de Vite.
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
